---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import Shows from "../components/Shows.astro";
import Pricing from "../components/Pricing.astro";
import Download from "../components/Download.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="ViewSwitcher: look professional when you go live"
  description="A one-click scene switcher for OBS, free for Mac. Pick a view (intro, teaching, interview, break) and your camera, screen and titles move into place.">
  <Header />
  <main id="main">
    <Hero />
    <HowItWorks />
    <Shows />
    <Features />
    <Pricing />
    <Download />
    <Faq />
  </main>
  <Footer />
</Base>
