---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import TemplatesStrip from "../components/TemplatesStrip.astro";
import Free from "../components/Free.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { macAppSchema } from "../site.config";
import { faqPage } from "../lib/seo";
import { FAQS } from "../data/faq";
---
<Base
  title="ViewSwitcher: free OBS scene switcher for Mac"
  description="ViewSwitcher is a free, custom scene manager and one-click switcher for OBS on Mac. Set up your views once; one click puts camera, screen and titles in place."
  schema={[macAppSchema("/"), faqPage(FAQS)]}>
  <Header />
  <main id="main">
    <Hero />
    <HowItWorks />
    <TemplatesStrip />
    <Free />
    <Faq />
  </main>
  <Footer />
</Base>
