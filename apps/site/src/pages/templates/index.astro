---
// SITE-29: every free template set, with its pack to download (SITE-26, built by scripts/packs.ts).
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TemplateCard from "../../components/TemplateCard.astro";
import PackInstall from "../../components/PackInstall.astro";
import { site, github } from "../../site.config";
import { SHOWS } from "../../data/shows";
import { breadcrumbs } from "../../lib/seo";
const skill = `${github}/blob/main/apps/server/library-kit/skills/viewswitcher-scenes/SKILL.md`;
---
<Base
  title="Free OBS overlay templates for Mac · ViewSwitcher"
  description="Free template sets for OBS: a sports podcast, gaming, church, travel, live events and cooking. Download a template pack and install it in ViewSwitcher on your Mac."
  path="/templates"
  schema={[breadcrumbs(site.url, [{ name: "Templates", path: "/templates" }])]}>
  <Header />
  <main id="main" class="wrap page">
    <div class="head">
      <p class="eyebrow">Templates</p>
      <h1>Free templates for every kind of show</h1>
      <p class="lede">Each template set is a whole look for a show: starting soon, the camera full screen, the main layout, a break and the goodbye. They're free, and they stay free.</p>
    </div>
    <ul class="grid">
      {SHOWS.map((s) => <li><TemplateCard show={s} /></li>)}
    </ul>
    <section class="how" aria-labelledby="how-packs">
      <div>
        <h2 id="how-packs">How template packs work</h2>
        <p>A template pack is a .zip of one template set. Each view in it is a small web page (HTML), so you can change any of it: retype titles, move boxes, add your logo.</p>
        <p>Want a set of your own? Code one, or have an AI assistant code one: the <a href={skill}>ViewSwitcher skill</a> teaches it the format.</p>
      </div>
      <div>
        <h3>Install one</h3>
        <PackInstall />
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .page { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem); display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .head { display: grid; gap: 1rem; }
  .head h1 { font-size: clamp(2.25rem, 5vw, 3.25rem); }
  .eyebrow { font: 600 0.8125rem/1 var(--text); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem 2rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .how { display: grid; gap: 2rem 4rem; border-top: 1px solid var(--rule); padding-top: 2.5rem; }
  @media (min-width: 60rem) { .how { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .how > div { display: grid; gap: 1rem; align-content: start; }
  .how h2 { font-size: clamp(1.4rem, 2.6vw, 1.75rem); }
  .how p { color: var(--ink-2); max-width: 36rem; }
  .how a { color: var(--ink); }
</style>
