---
import IpadStore from "./IpadStore.astro";
import { IPAD_PRICE } from "../lib/cta";
---
<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pricing-title">Free on the Mac</h2>
      <p class="lede">ViewSwitcher for Mac is free and open source. No subscription, no seats, no watermark. The iPad app is optional, and you pay for it once.</p>
    </div>
    <div class="plans">
      <article>
        <h3><a href="/download">ViewSwitcher for Mac</a></h3>
        <p class="price">Free</p>
        <ul>
          <li>The full set of views, in your colors</li>
          <li>As many shows and episodes as you like</li>
          <li>Your camera and screen placed for you in OBS</li>
          <li>Switch from the Mac app or a browser on the Mac</li>
          <li class="soon">Coming soon: pair your phone or iPad over Wi-Fi</li>
        </ul>
      </article>
      <article>
        <h3><a href="/ipad">ViewSwitcher for iPad</a></h3>
        <p class="price">{IPAD_PRICE} <span class="once">one time</span></p>
        <ul>
          <li>Switch views from an iPad beside you</li>
          <li>Plug it into the Mac with a USB-C cable: no Wi-Fi needed</li>
          <li>Retype titles and move boxes with a finger</li>
        </ul>
        <IpadStore />
      </article>
    </div>
  </div>
</section>
<style>
  .plans { display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  article { border: 1px solid var(--rule); border-radius: 14px; padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 1rem; align-content: start; }
  .price { font: 700 clamp(1.6rem, 3vw, 2.1rem)/1.1 var(--display); letter-spacing: -0.025em; }
  .once { font: 500 1rem var(--text); color: var(--ink-3); letter-spacing: 0; margin-left: 0.25rem; }
  ul { margin: 0; padding-left: 1.1rem; color: var(--ink-2); display: grid; gap: 0.4rem; }
  .soon { color: var(--ink-3); list-style: none; margin-left: -1.1rem; }
</style>
