---
// The hero's proof: a program monitor showing real scenes, and the covers you'd tap on the iPad.
// Tapping a cover swaps the scene and moves the Camera/Screen stand-ins into that scene's boxes,
// which is what ViewSwitcher does to the real OBS sources. When SITE-11's recording exists at
// site.demoVideo, the monitor plays it instead (poster: the first scene).
import { Picture, getImage } from "astro:assets";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import Device from "./Device.astro";
import { HERO } from "../data/scene-list";
import { scene, box } from "../lib/scenes";
import { site } from "../site.config";
import "../styles/scene.css";

const scenes = HERO.map((s) => scene(s.id));
const start = 1; // open on Teaching: the scene with both boxes
const devices = [...new Set(scenes.flatMap((s) => s.slots.map((d) => d.name)))];
const placeOf = (sIdx: number, name: string) => scenes[sIdx]!.slots.find((d) => d.name === name);
const hidden = { name: "", x: 1920 / 2, y: 1080 / 2, w: 0, h: 0, round: false };

// Astro builds from the project root (apps/site), locally and on Vercel.
const videoFile = resolve("public" + site.demoVideo);
const hasVideo = existsSync(videoFile);
const poster = hasVideo ? (await getImage({ src: scenes[start]!.image, width: 1600, format: "webp" })).src : undefined;
const sizes = "(min-width: 76rem) 75rem, calc(100vw - 2.5rem)";
const slotData = JSON.stringify(scenes.map((s) => s.slots));
---
<figure class="program on-dark" data-program data-slots={slotData} data-start={start}>
  <div class="monitor">
    <div class="bar">
      <span class="tally"><span class="dot"></span>On air</span>
      <span class="now" aria-live="polite" data-now>{scenes[start]!.name}</span>
    </div>
    {hasVideo ? (
      <div class="frame">
        <video src={site.demoVideo} poster={poster} autoplay muted loop playsinline preload="metadata" width="1920" height="1080"
          aria-label="A tap on the iPad switches the scene in OBS and the camera moves into its box."></video>
      </div>
    ) : (
      <div class="frame" data-frame>
        {scenes.map((s, i) => (
          <Picture src={s.image} alt={`${s.org} ${s.name} scene, rendered from its library`} widths={[640, 960, 1280, 1600]} sizes={sizes}
            formats={["webp"]} fallbackFormat="jpg" loading={i === start ? "eager" : "lazy"} fetchpriority={i === start ? "high" : "auto"}
            decoding={i === start ? "sync" : "async"} class:list={["shot", { on: i === start }]} data-shot={i} />
        ))}
        {devices.map((name) => {
          const at = placeOf(start, name);
          return <div class:list={["mover", { gone: !at }]} data-device={name} style={box(at ?? hidden)}>
            <Device place={{ ...(at ?? hidden), name, x: 0, y: 0, w: 1920, h: 1080 }} />
          </div>;
        })}
      </div>
    )}
  </div>
  {!hasVideo && (
    <div class="deck">
      <p class="deck-label" id="deck-label">Tap a scene</p>
      <div class="covers" role="group" aria-labelledby="deck-label">
        {scenes.map((s, i) => (
          <button type="button" class="cover" aria-pressed={i === start ? "true" : "false"} data-cover={i}>
            <Picture src={s.image} alt="" widths={[240, 360]} sizes="(min-width: 76rem) 14rem, 8rem" formats={["webp"]} fallbackFormat="jpg" loading="lazy" decoding="async" />
            <span>{s.name}</span>
          </button>
        ))}
      </div>
    </div>
  )}
  <figcaption>
    {hasVideo
      ? "A tap on the iPad, the scene changes in OBS, and the camera moves into its box."
      : "Real Daisy Debate scenes, rendered from its library. The gray boxes are where your camera and screen go; switch scenes and they move."}
  </figcaption>
</figure>

<style>
  .program { margin: 0; display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr); }
  .monitor { background: var(--monitor); border-radius: 16px; padding: 0.5rem; box-shadow: 0 1px 0 #ffffff14 inset, 0 30px 60px -30px #16181e66; }
  .bar { display: flex; align-items: center; gap: 0.9rem; padding: 0.35rem 0.5rem 0.6rem; color: var(--on-monitor-2); font-size: 0.8125rem; min-width: 0; }
  .tally { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--on-monitor); font-weight: 600; }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 3px #ff4d4f33; }
  .now { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .frame { border-radius: 10px; }
  .frame video { width: 100%; height: 100%; object-fit: cover; }
  .frame :global(.shot) { opacity: 0; transition: opacity 220ms ease; }
  .frame :global(.shot.on) { opacity: 1; }
  .mover { position: absolute; transition: left 520ms cubic-bezier(.2,.8,.2,1), top 520ms cubic-bezier(.2,.8,.2,1), width 520ms cubic-bezier(.2,.8,.2,1), height 520ms cubic-bezier(.2,.8,.2,1), opacity 200ms ease; }
  .mover.gone { opacity: 0; }
  .mover :global(.device) { inset: 0 !important; width: 100% !important; height: 100% !important; left: 0 !important; top: 0 !important; transition: border-radius 520ms ease; }
  .mover.round :global(.device) { border-radius: 50%; }

  .deck { background: var(--monitor); border-radius: 16px; padding: 0.75rem 0.75rem 0.6rem; }
  .deck-label { color: var(--on-monitor-2); font-size: 0.8125rem; padding: 0 0.3rem 0.6rem; }
  .covers { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(7.5rem, 1fr); gap: 0.5rem; overflow-x: auto; scrollbar-width: thin; }
  .cover { display: grid; gap: 0.35rem; padding: 0.3rem; margin: 0; border: 0; border-radius: 10px;
    background: transparent; color: var(--on-monitor-2); font: 500 0.8125rem/1.2 var(--text); text-align: left; cursor: pointer;
  }
  .cover :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 6px; outline: 2px solid transparent; outline-offset: 2px; }
  .cover:hover { color: var(--on-monitor); }
  .cover[aria-pressed="true"] { color: var(--on-monitor); }
  .cover[aria-pressed="true"] :global(img) { outline-color: var(--live); }
  .cover span { padding-inline: 0.15rem; }
  figcaption { grid-column: 1 / -1; color: var(--ink-3); font-size: 0.875rem; max-width: 46rem; }
  @media (prefers-reduced-motion: reduce) {
    .mover, .mover :global(.device), .frame :global(.shot) { transition: none; }
  }
</style>

<script>
  type Slot = { name: string; x: number; y: number; w: number; h: number; round: boolean };
  const root = document.querySelector<HTMLElement>("[data-program]");
  const frame = root?.querySelector<HTMLElement>("[data-frame]");
  if (root && frame) {
    const slots: Slot[][] = JSON.parse(root.dataset.slots!);
    const shots = [...frame.querySelectorAll<HTMLElement>("[data-shot]")];
    const covers = [...root.querySelectorAll<HTMLButtonElement>("[data-cover]")];
    const movers = [...frame.querySelectorAll<HTMLElement>("[data-device]")];
    const now = root.querySelector<HTMLElement>("[data-now]")!;
    const pct = (v: number, of: number) => `${(v / of) * 100}%`;

    const show = (i: number) => {
      shots.forEach((s) => s.classList.toggle("on", Number(s.dataset.shot) === i));
      covers.forEach((c) => c.setAttribute("aria-pressed", String(Number(c.dataset.cover) === i)));
      now.textContent = covers[i]!.textContent!.trim();
      for (const m of movers) {
        const at = slots[i]!.find((s) => s.name === m.dataset.device);
        m.classList.toggle("gone", !at);
        m.classList.toggle("round", !!at?.round);
        if (!at) continue;
        Object.assign(m.style, { left: pct(at.x, 1920), top: pct(at.y, 1080), width: pct(at.w, 1920), height: pct(at.h, 1080) });
      }
    };
    covers.forEach((c) => c.addEventListener("click", () => show(Number(c.dataset.cover))));
  }
</script>
