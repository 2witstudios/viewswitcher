---
// The hero's proof: the ViewSwitcher Mac window. A grid of view covers (the one on air marked in
// red) beside the program output. Clicking a cover swaps the view and glides the camera, guest and
// screen into its boxes, which is what ViewSwitcher does to the real OBS sources. Until someone
// clicks, a cursor demonstrates it every few seconds (never with prefers-reduced-motion, and only
// while the window is on screen). When SITE-11's recording exists at site.demoVideo, the program
// output plays it instead.
//
// Window chrome follows macOS (and the native app, MAC-13a): 12 px traffic lights 8 px apart,
// vertically centred in the title bar, with the switcher header inset to clear them.
import { Picture, getImage } from "astro:assets";
import Mark from "./Mark.astro";
import { showViews, box, radius, type View } from "../lib/views";
import { site } from "../site.config";

const SHOW = "kitchen";
const views = showViews(SHOW);
const start = views.findIndex((v) => v.file === "teaching");
const ground = views[0]!.ground;
const devices = [...new Map(views.flatMap((v) => v.slots.map((s) => [s.name, s.media] as const))).entries()];
const at = (v: View, name: string) => v.slots.find((s) => s.name === name);
const hidden = { x: 960, y: 540, w: 0, h: 0 };

if (site.demoVideo !== "/demo/viewswitcher-demo.mp4") throw new Error("site.demoVideo changed: update the check in astro.config.mjs");
const hasVideo = __HAS_DEMO_VIDEO__;
const poster = hasVideo ? (await getImage({ src: views[start]!.image, width: 1600, format: "webp" })).src : undefined;
const sizes = "(min-width: 76rem) 50rem, (min-width: 56rem) 66vw, calc(100vw - 3rem)";
const slotData = JSON.stringify(views.map((v) => v.slots.map(({ name, x, y, w, h, radius: r }) => ({ name, x, y, w, h, r: radius(r) }))));
---
<figure class="program" data-program data-slots={slotData}>
  <div class="window on-dark">
    <div class="titlebar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="app"><Mark size={18} /><b>{views[0]!.show.name}</b><span class="ep">Ep. 31 · Sunday bread</span></span>
      <span class="obs"><i></i>OBS connected</span>
    </div>
    <div class="body">
      <div class="stage">
        <div class="stage-bar">
          <span class="tally"><span class="dot"></span>On air</span>
          <span class="now" aria-live="polite" data-now>{views[start]!.name}</span>
        </div>
        {hasVideo ? (
          <div class="frame">
            <video src={site.demoVideo} poster={poster} autoplay muted loop playsinline preload="metadata" width="1920" height="1080"
              aria-label="A view is clicked, the stream changes, and the camera moves into its new place."></video>
          </div>
        ) : (
          <div class="frame" data-frame style={`background:${ground}`}>
            {devices.map(([name, m]) => {
              const s = at(views[start]!, name);
              return (
                <div class:list={["box", "mover", { gone: !s }]} data-device={name} style={{ ...box(s ?? hidden), borderRadius: s ? radius(s.radius) : "0" }}>
                  <Picture src={m.image} alt="" widths={[480, 960, 1440]} sizes={sizes} formats={["webp"]} fallbackFormat="jpg"
                    loading="eager" decoding="async" style={`object-position:${m.focus}`} />
                </div>
              );
            })}
            {views.map((v, i) => (
              <Picture src={v.image} alt="" widths={[640, 960, 1280, 1600]} sizes={sizes} formats={["webp"]} fallbackFormat="png"
                loading={i === start ? "eager" : "lazy"} fetchpriority={i === start ? "high" : "auto"} decoding="async"
                class:list={["overlay", "shot", { on: i === start }]} data-shot={i} />
            ))}
            <span class="sr" data-alt>{`${views[start]!.show.name}, ${views[start]!.name} view`}</span>
          </div>
        )}
      </div>
      <div class="deck">
        <p class="deck-label" id="deck-label">Views</p>
        <div class="covers" role="group" aria-labelledby="deck-label">
          {views.map((v, i) => (
            <button type="button" class="cover" aria-pressed={i === start ? "true" : "false"} data-cover={i}>
              <span class="thumb" style={`background:${v.ground}`}>
                {v.slots.map((s) => (
                  <span class="box" style={{ ...box(s), borderRadius: radius(s.radius) }}>
                    <Picture src={s.media.image} alt="" widths={[240]} sizes="10rem" formats={["webp"]} fallbackFormat="jpg" loading="lazy" decoding="async" style={`object-position:${s.media.focus}`} />
                  </span>
                ))}
                <Picture src={v.image} alt="" widths={[240, 360]} sizes="(min-width: 56rem) 11rem, 30vw" formats={["webp"]} fallbackFormat="png" loading="lazy" decoding="async" class="overlay" />
                <span class="badge" aria-hidden="true"><span class="dot"></span>On air</span>
              </span>
              <span class="name">{v.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
    <span class="cursor" aria-hidden="true" data-cursor><svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2.5v17.2l4.6-4.4 3 6.7 2.8-1.2-3-6.6 6.4-.4z" fill="#fff" stroke="#111" stroke-width="1.3" stroke-linejoin="round"/></svg></span>
  </div>
  <figcaption>Click a view. The stream changes, and your camera, guest and screen move to where the view puts them.</figcaption>
</figure>

<style>
  .program { margin: 0; display: grid; gap: 0.9rem; grid-template-columns: minmax(0, 1fr); }
  .window {
    position: relative; background: #15171c; color: var(--on-monitor); border-radius: 12px; overflow: hidden;
    /* The app's own dark UI, lifted off the white page by a soft shadow. */
    box-shadow: 0 0 0 1px #00000040, 0 1px 0 #ffffff12 inset, 0 40px 80px -30px #16181e80, 0 18px 36px -18px #16181e59;
  }
  /* macOS title bar: 12 px lights, 8 px apart, centred vertically; the header clears them. */
  .titlebar { --tb: 44px; position: relative; height: var(--tb); display: flex; align-items: center; gap: 1rem;
    padding: 0 16px 0 calc(16px + 3 * 12px + 2 * 8px + 18px); background: #1b1e24; border-bottom: 1px solid #00000059; font-size: 0.8125rem; }
  .lights { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 0.5px #0000004d; }
  .lights i:nth-child(1) { background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .app { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
  .app :global(svg) { flex: none; }
  .app :global(svg rect:last-child) { fill: #f4f5f7; stroke: #1b1e24; }
  .app b { font-weight: 600; white-space: nowrap; }
  .ep { color: var(--on-monitor-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .obs { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; color: var(--on-monitor-2); white-space: nowrap; }
  .obs i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #a3a8b5; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1px; background: #00000059; }
  @media (min-width: 56rem) { .body { grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr); } }
  .stage, .deck { background: #111317; padding: 0.9rem; min-width: 0; }
  .stage-bar { display: flex; align-items: center; gap: 0.8rem; padding: 0 0.1rem 0.7rem; font-size: 0.8125rem; color: var(--on-monitor-2); }
  .tally { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--on-monitor); font-weight: 600; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 3px #ff4d4f33; flex: none; }
  .now { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .frame { border-radius: 8px; }
  .frame video { width: 100%; height: 100%; object-fit: cover; }
  .frame :global(.shot) { opacity: 0; transition: opacity 240ms ease; }
  .frame :global(.shot.on) { opacity: 1; }
  .mover { transition: left 620ms cubic-bezier(.2,.8,.2,1), top 620ms cubic-bezier(.2,.8,.2,1), width 620ms cubic-bezier(.2,.8,.2,1), height 620ms cubic-bezier(.2,.8,.2,1), border-radius 620ms ease, opacity 220ms ease; }
  .mover.gone { opacity: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .deck-label { color: var(--on-monitor-2); font-size: 0.8125rem; padding: 0 0.1rem 0.7rem; }
  .covers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem 0.55rem; }
  @media (min-width: 56rem) { .covers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cover { display: grid; gap: 0.4rem; padding: 0; margin: 0; border: 0; background: transparent; color: var(--on-monitor-2);
    font: 500 0.75rem/1.2 var(--text); text-align: left; cursor: pointer; transition: transform 120ms ease; }
  .cover.press { transform: scale(0.96); }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; outline: 2px solid #ffffff14; outline-offset: 2px; container-type: inline-size; transition: outline-color 160ms ease; }
  .thumb .box { position: absolute; overflow: hidden; }
  .thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; left: 4px; top: 4px; display: none; align-items: center; gap: 0.3rem; background: #000000b3; color: #fff;
    font: 600 0.625rem/1 var(--text); padding: 0.25rem 0.4rem; border-radius: 999px; }
  .badge .dot { width: 0.4rem; height: 0.4rem; box-shadow: none; }
  .cover:hover .thumb { outline-color: #ffffff40; }
  .cover[aria-pressed="true"] { color: var(--on-monitor); }
  .cover[aria-pressed="true"] .thumb { outline-color: var(--live); }
  .cover[aria-pressed="true"] .badge { display: inline-flex; }
  .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .cursor { position: absolute; left: 0; top: 0; z-index: 2; opacity: 0; pointer-events: none; filter: drop-shadow(0 2px 3px #0006);
    transition: transform 900ms cubic-bezier(.45,.05,.25,1), opacity 300ms ease; }
  .cursor.show { opacity: 1; }
  figcaption { color: var(--ink-3); font-size: 0.875rem; max-width: 46rem; }
  @media (prefers-reduced-motion: reduce) {
    .mover, .frame :global(.shot), .cover, .cursor { transition: none; }
    .cursor { display: none; }
  }
</style>

<script>
  type Slot = { name: string; x: number; y: number; w: number; h: number; r: string };
  const root = document.querySelector<HTMLElement>("[data-program]");
  const frame = root?.querySelector<HTMLElement>("[data-frame]");
  if (root && frame) {
    const slots: Slot[][] = JSON.parse(root.dataset.slots!);
    const shots = [...frame.querySelectorAll<HTMLElement>("[data-shot]")];
    const covers = [...root.querySelectorAll<HTMLButtonElement>("[data-cover]")];
    const movers = [...frame.querySelectorAll<HTMLElement>("[data-device]")];
    const now = root.querySelector<HTMLElement>("[data-now]")!;
    const alt = frame.querySelector<HTMLElement>("[data-alt]")!;
    const cursor = root.querySelector<HTMLElement>("[data-cursor]")!;
    const win = root.querySelector<HTMLElement>(".window")!;
    const pct = (v: number, of: number) => `${(v / of) * 100}%`;
    let current = covers.findIndex((c) => c.getAttribute("aria-pressed") === "true");

    const show = (i: number) => {
      current = i;
      shots.forEach((s) => s.classList.toggle("on", Number(s.dataset.shot) === i));
      covers.forEach((c) => c.setAttribute("aria-pressed", String(Number(c.dataset.cover) === i)));
      const name = covers[i]!.querySelector(".name")!.textContent!.trim();
      now.textContent = name;
      alt.textContent = alt.textContent!.replace(/, [^,]+ view$/, `, ${name} view`);
      for (const m of movers) {
        const at = slots[i]!.find((s) => s.name === m.dataset.device);
        m.classList.toggle("gone", !at);
        if (!at) continue;
        Object.assign(m.style, { left: pct(at.x, 1920), top: pct(at.y, 1080), width: pct(at.w, 1920), height: pct(at.h, 1080), borderRadius: at.r });
      }
    };

    // The demo: until someone clicks, a cursor walks the running order of the show.
    const tour = [2, 3, 1, 2, 4, 0].map((n) => n % covers.length);
    let step = 0, timer = 0, visible = false, stopped = false;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const stop = () => { stopped = true; clearTimeout(timer); cursor.classList.remove("show"); };
    const tick = () => {
      if (stopped || !visible || reduced.matches || document.hidden) return;
      let next = tour[step++ % tour.length]!;
      if (next === current) next = tour[step++ % tour.length]!;
      const c = covers[next]!.querySelector<HTMLElement>(".thumb")!.getBoundingClientRect();
      const w = win.getBoundingClientRect();
      cursor.style.transform = `translate(${c.left - w.left + c.width * 0.55}px, ${c.top - w.top + c.height * 0.55}px)`;
      cursor.classList.add("show");
      timer = window.setTimeout(() => {
        covers[next]!.classList.add("press");
        setTimeout(() => covers[next]!.classList.remove("press"), 140);
        show(next);
        timer = window.setTimeout(tick, 2600);
      }, 1000);
    };
    // Start the cursor resting over the program, then begin.
    cursor.style.transform = `translate(${win.clientWidth * 0.4}px, ${win.clientHeight * 0.55}px)`;
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      clearTimeout(timer);
      if (visible && !stopped) timer = window.setTimeout(tick, 1400);
    }, { threshold: 0.4 }).observe(win);
    document.addEventListener("visibilitychange", () => { clearTimeout(timer); if (!document.hidden && visible && !stopped) timer = window.setTimeout(tick, 1400); });

    covers.forEach((c) => c.addEventListener("click", (e) => {
      if (e.isTrusted) stop();
      show(Number(c.dataset.cover));
    }));
    root.addEventListener("pointerdown", stop, { once: true });
  }
</script>
