---
// The hero's proof: the live stream, with an iPad running the switcher in front of it, bottom right.
// The iPad shows the switcher with the library closed: the show's views as covers, the one on air
// ringed in red. Tapping a cover swaps the view and glides the camera, guest and screen into its
// boxes, which is what ViewSwitcher does to the real OBS sources. Until someone taps, a finger
// demonstrates it every few seconds (never with prefers-reduced-motion, and only while it's on
// screen). When the demo recording exists at site.demoVideo, the stream plays it instead.
//
// Proportions (the design canvas): the stream and the iPad are centred together as one block, 1280
// wide; the stream is 1120 × 630 at its top left, the iPad 700 wide at its bottom right, hanging
// 160 past the stream and 140 below it. On phones the iPad sits under the stream, overlapping it.
import { Picture, getImage } from "astro:assets";
import { showViews, box, radius, type View } from "../lib/views";
import { site } from "../site.config";

const SHOW = "fullcount";
const views = showViews(SHOW);
const start = views.findIndex((v) => v.file === "live");
const ground = views[0]!.ground;
const devices = [...new Map(views.flatMap((v) => v.slots.map((s) => [s.name, s.media] as const))).entries()];
const at = (v: View, name: string) => v.slots.find((s) => s.name === name);
const hidden = { x: 960, y: 540, w: 0, h: 0 };

if (site.demoVideo !== "/demo/viewswitcher-demo.mp4") throw new Error("site.demoVideo changed: update the check in astro.config.mjs");
const hasVideo = __HAS_DEMO_VIDEO__;
const poster = hasVideo ? (await getImage({ src: views[start]!.image, width: 1600, format: "webp" })).src : undefined;
const sizes = "(min-width: 80rem) 70rem, calc(100vw - 3rem)";
const slotData = JSON.stringify(views.map((v) => v.slots.map(({ name, x, y, w, h, radius: r }) => ({ name, x, y, w, h, r: radius(r) }))));
---
<figure class="program" data-program data-slots={slotData}>
  <div class="scene" data-scene>
    {hasVideo ? (
      <div class="frame">
        <video src={site.demoVideo} poster={poster} autoplay muted loop playsinline preload="metadata" width="1920" height="1080"
          aria-label="A view is tapped on the iPad, the stream changes, and the camera moves into its new place."></video>
      </div>
    ) : (
      <div class="frame" data-frame style={`background:${ground}`}>
        {devices.map(([name, m]) => {
          const s = at(views[start]!, name);
          return (
            <div class:list={["box", "mover", { gone: !s }]} data-device={name} style={{ ...box(s ?? hidden), borderRadius: s ? radius(s.radius) : "0" }}>
              <Picture src={m.image} alt="" widths={[480, 960, 1440]} sizes={sizes} formats={["webp"]} fallbackFormat="jpg"
                loading="eager" decoding="async" style={`object-position:${m.focus}`} />
            </div>
          );
        })}
        {views.map((v, i) => (
          <Picture src={v.image} alt="" widths={[640, 960, 1280, 1600]} sizes={sizes} formats={["webp"]} fallbackFormat="png"
            loading={i === start ? "eager" : "lazy"} fetchpriority={i === start ? "high" : "auto"} decoding="async"
            class:list={["overlay", "shot", { on: i === start }]} data-shot={i} />
        ))}
        <span class="sr" data-alt>{`${views[start]!.show.name}, ${views[start]!.name} view`}</span>
      </div>
    )}
    <div class="ipad on-dark">
      <div class="screen">
        <div class="bar">
          <span class="lib" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M9 4v16"/></svg></span>
          <span class="title"><small>{views[0]!.show.name} · Nov 25</small><b>{views[0]!.show.episode.split(" · ")[0]}</b></span>
          <span class="tally"><span class="dot"></span><span>On air: <span class="now" aria-live="polite" data-now>{views[start]!.name}</span></span></span>
          <span class="live" aria-hidden="true"><i></i>LIVE</span>
        </div>
        <p class="deck-label" id="deck-label">From the project</p>
        <div class="covers" role="group" aria-labelledby="deck-label">
          {views.map((v, i) => (
            <button type="button" class="cover" aria-pressed={i === start ? "true" : "false"} data-cover={i}>
              <span class="thumb" style={`background:${v.ground}`}>
                {v.slots.map((s) => (
                  <span class="box" style={{ ...box(s), borderRadius: radius(s.radius) }}>
                    <Picture src={s.media.image} alt="" widths={[240, 480]} sizes="14rem" formats={["webp"]} fallbackFormat="jpg" loading="lazy" decoding="async" style={`object-position:${s.media.focus}`} />
                  </span>
                ))}
                <Picture src={v.image} alt="" widths={[240, 480]} sizes="(min-width: 56rem) 14rem, 30vw" formats={["webp"]} fallbackFormat="png" loading="lazy" decoding="async" class="overlay" />
                <span class="badge" aria-hidden="true">On air</span>
              </span>
              <span class="name">{v.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
    <span class="finger" aria-hidden="true" data-finger></span>
  </div>
  <figcaption>Tap a view on your iPad or iPhone, or click it on the Mac. The stream changes, and your camera, guest and screen move to where the view puts them.</figcaption>
</figure>

<style>
  .program { margin: 0; display: grid; gap: 1.1rem; grid-template-columns: minmax(0, 1fr); justify-items: center; }
  /* One block, 1280 × 770 on the canvas: the stream top left, the iPad bottom right. */
  .scene { position: relative; width: 100%; max-width: 80rem; aspect-ratio: 1280 / 770; container-type: inline-size; }
  .frame { position: absolute; left: 0; top: 0; width: 87.5%; aspect-ratio: 16 / 9; border-radius: 1.1cqi; overflow: hidden;
    box-shadow: 0 0 0 1px #0000001f, 0 30px 60px -24px #0b142659; }
  .frame video { width: 100%; height: 100%; object-fit: cover; }
  .frame :global(.shot) { opacity: 0; transition: opacity 240ms ease; }
  .frame :global(.shot.on) { opacity: 1; }
  .mover { transition: left 620ms cubic-bezier(.2,.8,.2,1), top 620ms cubic-bezier(.2,.8,.2,1), width 620ms cubic-bezier(.2,.8,.2,1), height 620ms cubic-bezier(.2,.8,.2,1), border-radius 620ms ease, opacity 220ms ease; }
  .mover.gone { opacity: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* The iPad: 700 of 1280 wide, a 16 px bezel, its shadow falling back onto the stream. */
  .ipad { position: absolute; right: 0; bottom: 0; width: 54.6875%; box-sizing: border-box; padding: 1.25cqi; border-radius: 2.65cqi;
    background: #1a1b20; color: var(--on-monitor);
    box-shadow: 0 0 0 2px #3a3c44, -24px 36px 70px -10px #0000008c, 0 12px 24px #0000004d; }
  .screen { aspect-ratio: 4 / 3; border-radius: 1.4cqi; overflow: hidden; background: #0b0c0f; container-type: inline-size;
    padding: 3cqi 3.3cqi; display: flex; flex-direction: column; gap: 2.4cqi; box-sizing: border-box; }
  .bar { display: flex; align-items: center; gap: 1.5cqi; }
  .lib { width: 5.1cqi; height: 5.1cqi; flex: none; box-sizing: border-box; border: 1px solid #343846; border-radius: 1.2cqi; display: grid; place-items: center; }
  .lib svg { width: 2.4cqi; height: 2.4cqi; }
  .title { display: grid; flex: 1; min-width: 0; line-height: 1.1; }
  .title small { font-size: max(9px, 1.5cqi); color: var(--on-monitor-2); }
  .title b { font-size: 3cqi; font-weight: 700; letter-spacing: -0.02em; }
  .tally { display: inline-flex; align-items: center; gap: 0.9cqi; padding: 0.9cqi 1.65cqi; border-radius: 999px; background: #1c1f27;
    font-size: max(10px, 1.65cqi); font-weight: 600; white-space: nowrap; }
  .tally .now { font-weight: 600; }
  .dot { width: 1.05cqi; height: 1.05cqi; border-radius: 50%; background: var(--live); flex: none; }
  .live { display: inline-flex; align-items: center; gap: 0.9cqi; padding: 0.9cqi 1.8cqi; border-radius: 1.2cqi; background: var(--live); color: #fff;
    font-size: max(10px, 1.65cqi); font-weight: 700; letter-spacing: 0.14em; }
  .live i { width: 0.9cqi; height: 0.9cqi; border-radius: 50%; background: #fff; }
  .deck-label { margin: 0; font-size: max(8px, 1.35cqi); font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--on-monitor-2); }

  .covers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.4cqi 2.1cqi; }
  .cover { display: grid; gap: 1cqi; padding: 0; margin: 0; border: 0; background: transparent; color: var(--on-monitor);
    font: 600 max(10px, 1.95cqi)/1.2 var(--text); text-align: left; cursor: pointer; transition: transform 120ms ease; }
  .cover.press { transform: scale(0.96); }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 1cqi; overflow: hidden; outline: 2px solid #ffffff14; outline-offset: 2px; transition: outline-color 160ms ease; }
  .thumb .box { position: absolute; overflow: hidden; }
  .thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; left: 0.9cqi; top: 0.9cqi; display: none; background: var(--live); color: #fff;
    font: 700 max(7px, 1.2cqi)/1 var(--text); letter-spacing: 0.16em; text-transform: uppercase; padding: 0.4cqi 0.9cqi; border-radius: 0.75cqi; }
  .cover:hover .thumb { outline-color: #ffffff40; }
  .cover[aria-pressed="true"] .thumb { outline-color: var(--live); }
  .cover[aria-pressed="true"] .badge { display: block; }
  .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Phones: the stream full width, the iPad under it, overlapping its bottom edge. */
  @media (max-width: 40rem) {
    .scene { aspect-ratio: auto; display: grid; }
    .frame { position: relative; width: 100%; border-radius: 10px; }
    .ipad { position: relative; justify-self: end; width: 92%; margin-top: -14%; padding: 8px; border-radius: 20px; }
    .screen { border-radius: 12px; }
  }

  /* A fingertip, for the demo taps. */
  .finger { position: absolute; left: 0; top: 0; z-index: 2; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%;
    background: #ffffff59; box-shadow: 0 0 0 1.5px #ffffffb3, 0 4px 12px #0006; opacity: 0; pointer-events: none;
    transition: transform 900ms cubic-bezier(.45,.05,.25,1), opacity 300ms ease, scale 140ms ease; }
  .finger.show { opacity: 1; }
  .finger.down { scale: 0.8; }
  figcaption { color: var(--ink-3); font-size: 0.875rem; max-width: 46rem; text-align: center; }
  @media (prefers-reduced-motion: reduce) {
    .mover, .frame :global(.shot), .cover, .finger { transition: none; }
    .finger { display: none; }
  }
</style>

<script>
  type Slot = { name: string; x: number; y: number; w: number; h: number; r: string };
  const root = document.querySelector<HTMLElement>("[data-program]");
  const frame = root?.querySelector<HTMLElement>("[data-frame]");
  if (root && frame) {
    const slots: Slot[][] = JSON.parse(root.dataset.slots!);
    const shots = [...frame.querySelectorAll<HTMLElement>("[data-shot]")];
    const covers = [...root.querySelectorAll<HTMLButtonElement>("[data-cover]")];
    const movers = [...frame.querySelectorAll<HTMLElement>("[data-device]")];
    const now = root.querySelector<HTMLElement>("[data-now]")!;
    const alt = frame.querySelector<HTMLElement>("[data-alt]")!;
    const finger = root.querySelector<HTMLElement>("[data-finger]")!;
    const win = root.querySelector<HTMLElement>("[data-scene]")!;
    const pct = (v: number, of: number) => `${(v / of) * 100}%`;
    let current = covers.findIndex((c) => c.getAttribute("aria-pressed") === "true");

    const show = (i: number) => {
      current = i;
      shots.forEach((s) => s.classList.toggle("on", Number(s.dataset.shot) === i));
      covers.forEach((c) => c.setAttribute("aria-pressed", String(Number(c.dataset.cover) === i)));
      const name = covers[i]!.querySelector(".name")!.textContent!.trim();
      now.textContent = name;
      alt.textContent = alt.textContent!.replace(/, [^,]+ view$/, `, ${name} view`);
      for (const m of movers) {
        const at = slots[i]!.find((s) => s.name === m.dataset.device);
        m.classList.toggle("gone", !at);
        if (!at) continue;
        Object.assign(m.style, { left: pct(at.x, 1920), top: pct(at.y, 1080), width: pct(at.w, 1920), height: pct(at.h, 1080), borderRadius: at.r });
      }
    };

    // The demo: until someone taps, a finger walks the running order of the show.
    const tour = [1, 2, 3, 2, 4, 0].map((n) => n % covers.length);
    let step = 0, timer = 0, visible = false, stopped = false;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const stop = () => { stopped = true; clearTimeout(timer); finger.classList.remove("show"); };
    const tick = () => {
      if (stopped || !visible || reduced.matches || document.hidden) return;
      let next = tour[step++ % tour.length]!;
      if (next === current) next = tour[step++ % tour.length]!;
      const c = covers[next]!.querySelector<HTMLElement>(".thumb")!.getBoundingClientRect();
      const w = win.getBoundingClientRect();
      finger.style.transform = `translate(${c.left - w.left + c.width * 0.55}px, ${c.top - w.top + c.height * 0.55}px)`;
      finger.classList.add("show");
      timer = window.setTimeout(() => {
        covers[next]!.classList.add("press");
        finger.classList.add("down");
        setTimeout(() => { covers[next]!.classList.remove("press"); finger.classList.remove("down"); }, 140);
        show(next);
        timer = window.setTimeout(tick, 2600);
      }, 1000);
    };
    // Start the finger resting over the iPad, then begin.
    finger.style.transform = `translate(${win.clientWidth * 0.75}px, ${win.clientHeight * 0.85}px)`;
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      clearTimeout(timer);
      if (visible && !stopped) timer = window.setTimeout(tick, 1400);
    }, { threshold: 0.4 }).observe(win);
    document.addEventListener("visibilitychange", () => { clearTimeout(timer); if (!document.hidden && visible && !stopped) timer = window.setTimeout(tick, 1400); });

    covers.forEach((c) => c.addEventListener("click", (e) => {
      if (e.isTrusted) stop();
      show(Number(c.dataset.cover));
    }));
    root.addEventListener("pointerdown", stop, { once: true });
  }
</script>
