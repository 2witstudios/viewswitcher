---
// SITE-14: six made-up shows, each a full set of views with its own look (scripts/shows/<id>/,
// rendered by scripts/library.ts and scripts/shots.ts). Each card leads with the show's main view.
import ViewFrame from "./ViewFrame.astro";
import { SHOWS } from "../data/shows";
const lead = "main";
const shows = SHOWS;
---
<section class="section" id="shows" aria-labelledby="shows-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="shows-title">Don't be the only one live without a professional look.</h2>
      <p class="lede">Every show gets a full set of views with its own look, from the countdown to the goodbye. Here are six made-up shows to show the range.</p>
    </div>
    <ul class="shows">
      {shows.map((s) => (
        <li>
          <ViewFrame show={s.id} file={lead} sizes="(min-width: 48rem) 36rem, calc(100vw - 2.5rem)" class="main" />
          <div class="strip">
            {s.views.filter((v) => v.file !== lead).slice(0, 3).map((v) => (
              <figure><ViewFrame show={s.id} file={v.file} sizes="(min-width: 48rem) 11rem, 30vw" widths={[240, 360, 480]} class="mini" /><figcaption>{v.name}</figcaption></figure>
            ))}
          </div>
          <h3>{s.name} <span class="kind">{s.kind}</span></h3>
          <p>{s.blurb}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .shows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 4rem 2.5rem; }
  @media (min-width: 48rem) { .shows { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .shows li { display: grid; gap: 0.6rem; align-content: start; }
  .shows :global(.main) { border-radius: 12px; box-shadow: 0 24px 48px -28px #16181e80; }
  .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; margin: 0.4rem 0 0.8rem; }
  .strip figure { margin: 0; display: grid; gap: 0.35rem; }
  .strip :global(.mini) { border-radius: 6px; }
  .strip figcaption { font-size: 0.8125rem; color: var(--ink-3); }
  .kind { font: 500 0.9375rem var(--text); color: var(--ink-3); letter-spacing: 0; margin-left: 0.35rem; }
  .shows p { color: var(--ink-2); max-width: 34rem; }
</style>
