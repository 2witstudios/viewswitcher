---
// The primary button (one config switch, see site.config.ts).
import Icon from "./Icon.astro";
import { cta } from "../site.config";
---
<div class="actions">
  <a class="btn btn-primary" href={cta.primary.href}>
    <Icon name={cta.state === "download" ? "download" : "bell"} />{cta.primary.label}
  </a>
</div>
