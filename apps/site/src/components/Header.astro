---
import Logo from "./Logo.astro";
---
<header class="top wrap">
  <a class="brand" href="/" aria-label="ViewSwitcher home"><Logo height={22} /></a>
  <nav aria-label="Sections">
    <a class="hide-sm" href="/#how">How it works</a>
    <a href="/templates">Templates</a>
    <a class="hide-sm" href="/#faq">Questions</a>
    <a href="/#download">Download</a>
  </nav>
</header>
<style>
  .top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: max(1.25rem, env(safe-area-inset-top, 0px)) 1.25rem; }
  .brand { display: inline-flex; align-items: center; padding-block: 0.5rem; color: var(--ink); }
  nav { display: flex; gap: 1.5rem; font-size: 0.9375rem; }
  nav a { text-decoration: none; color: var(--ink-2); padding-block: 0.5rem; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 40rem) { .hide-sm { display: none; } }
</style>
