---
// The footer (Jono's design): the wordmark and what ViewSwitcher is, then one row of links.
import Logo from "./Logo.astro";
import { descriptor } from "../site.config";
const links = [
  { href: "/download", label: "Download" },
  { href: "/templates", label: "Templates" },
  { href: "/setup", label: "Set up OBS" },
  { href: "/ipad", label: "iPad" },
  { href: "/church-livestream", label: "Church livestreaming" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy" },
];
---
<footer>
  <div class="wrap row">
    <div class="about">
      <a class="brand" href="/"><Logo height={19} label /></a>
      <p>{descriptor}</p>
    </div>
    <nav aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--rule); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem 3rem; padding-block: 3rem calc(4rem + env(safe-area-inset-bottom, 0px)); font-size: 0.9375rem; color: var(--ink-2); }
  .about { display: grid; gap: 0.6rem; align-content: start; }
  .brand { display: inline-flex; color: var(--ink); width: fit-content; }
  nav { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; align-content: start; }
  nav a { color: var(--ink-2); padding-block: 0.2rem; }
</style>
