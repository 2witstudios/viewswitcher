---
import { Picture } from "astro:assets";
import Device from "./Device.astro";
import { scene } from "../lib/scenes";
import "../styles/scene.css";
interface Props { id: string; alt: string; sizes: string; widths?: number[]; class?: string }
const { id, alt, sizes, widths = [480, 720, 960, 1280], class: cls } = Astro.props;
const s = scene(id);
---
<div class:list={["frame", cls]}>
  <Picture src={s.image} alt={alt} widths={widths} sizes={sizes} formats={["webp"]} fallbackFormat="jpg" loading="lazy" decoding="async" />
  {s.slots.map((slot) => <Device place={slot} />)}
</div>
