---
import { github, site } from "../site.config";
import { IPAD_PRICE } from "../lib/cta";
const faqs = [
  { q: "Do I need OBS?", a: "Yes. OBS is the free app that does the streaming, and ViewSwitcher sets it up for you the first time. After that, ViewSwitcher tells OBS what to show and where your camera goes; you keep streaming to YouTube, Facebook or wherever you go live today." },
  { q: "Do I need to know how to code?", a: "No. You pick views, type in your show's name and titles, and drag boxes where you want them." },
  { q: "Do I need AI?", a: "No. The views in the set are ready to use as they are. If you ever want a kind of view that isn't in the set, you can describe it and an AI assistant can make it for you, but that's optional." },
  { q: "Does it work on Windows?", a: "Not yet. ViewSwitcher is Mac only for now. If you'd use it on Windows, tell us on GitHub." },
  { q: "Can my church use it?", a: "Yes. Set up views once for your service (a welcome, worship, the sermon with slides beside the pastor, giving, the ending) and each Sunday is just new titles. There's no yearly seat fee." },
  { q: "Does it work with my camera?", a: "If OBS can see it, ViewSwitcher can place it: the Mac's built-in camera, a USB webcam, or a camera through a capture card. Your screen share and an iPad's screen work the same way." },
  { q: "What does it cost?", a: `The Mac app is free and open source, with no subscription. The iPad app is optional: ${IPAD_PRICE}, once, ${site.ipadApp.state === "store" ? "on the App Store" : "when it arrives on the App Store"}.` },
];
---
<section class="section mist" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="section-head">
      <h2 id="faq-title">Questions</h2>
      <p class="lede">Something else? <a href={`${github}/issues`}>Ask on GitHub</a>.</p>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 60rem) { .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 5rem; } }
  details { border-top: 1px solid var(--rule); }
  details:last-child { border-bottom: 1px solid var(--rule); }
  summary { list-style: none; cursor: pointer; padding-block: 1.25rem; font: 600 1.25rem/1.25 var(--display); letter-spacing: -0.015em; color: var(--ink); display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ""; flex: none; width: 0.6rem; height: 0.6rem; border-right: 2px solid var(--ink-2); border-bottom: 2px solid var(--ink-2); transform: rotate(45deg) translateY(-25%); transition: transform 160ms ease; }
  details[open] summary::after { transform: rotate(-135deg) translateY(-25%); }
  details p { color: var(--ink-2); padding-bottom: 1.4rem; max-width: 38rem; }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
