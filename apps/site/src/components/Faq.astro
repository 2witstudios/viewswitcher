---
import { FAQS as faqs } from "../data/faq";
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title">Questions</h2>
    <div class="list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}{f.more && <> <a href={f.more.href}>{f.more.label}</a>.</>}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  h2 { margin-bottom: 1.4rem; }
  .list { border-top: 1px solid var(--rule); }
  details { border-bottom: 1px solid var(--rule); }
  summary { list-style: none; cursor: pointer; padding-block: 1.15rem; font-size: 1.125rem; color: var(--ink); display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; flex: none; color: var(--ink-3); font-size: 1.25rem; line-height: 1; transition: transform 160ms ease; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { color: var(--ink-2); padding-bottom: 1.3rem; max-width: 44rem; }
  details a { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
