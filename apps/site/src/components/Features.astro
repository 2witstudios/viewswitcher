---
import ViewFrame from "./ViewFrame.astro";
const groups = [
  { title: "Run the show", items: [
    { h: "One click changes everything", p: "The layout, the titles and where your camera and screen sit all change together." },
    { h: "Switch from the Mac or an iPad", p: "The Mac app, a browser on the Mac, or an iPad on a USB-C cable beside you. Coming soon: pair your phone or iPad over Wi-Fi." },
    { h: "A new episode in a minute", p: "Each episode gets its own titles while the views stay the same, so next week is just a new title." },
  ] },
  { title: "Make it yours", items: [
    { h: "A designed set of views", p: "Starting soon, talking head, screen and camera, interview, be right back and thanks for watching, ready the first time you open it." },
    { h: "Edit right on the view", p: "Retype a title or drag a box where you want it, even while you're live. Viewers see the change as you make it." },
    { h: "Your colors and logo", p: "Set them once and every view uses them." },
    { h: "Clean transitions", p: "A calm fade between views, so switching never looks like a glitch." },
  ] }
];
---
<section class="section" id="features" aria-labelledby="features-title">
  <div class="wrap grid">
    <div class="side">
      <div class="section-head">
        <h2 id="features-title">Everything a show needs, nothing it doesn't</h2>
        <p class="lede">Set up your look once. Run every show with one hand.</p>
      </div>
      <figure>
        <ViewFrame show="grace" file="main" alt="Grace Community's sermon view: the scripture beside the pastor, letterboxed, with the sermon title" sizes="(min-width: 60rem) 30rem, calc(100vw - 2.5rem)" class="rounded" />
        <figcaption class="quiet">The scripture, the sermon title and the camera box are all things you can retype or drag, right on the view.</figcaption>
      </figure>
    </div>
    <div class="groups">
      {groups.map((g) => (
        <div>
          <p class="group">{g.title}</p>
          <ul class="list">
            {g.items.map((f) => <li><h3>{f.h}</h3><p>{f.p}</p></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; gap: 3rem; }
  @media (min-width: 60rem) { .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 5rem; } .side { position: sticky; top: 2rem; align-self: start; } }
  figure { margin: 0; display: grid; gap: 0.75rem; }
  .side :global(.rounded) { border-radius: 12px; }
  .groups { display: grid; gap: 2.5rem; }
  .group { font: 600 0.8125rem/1 var(--text); letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.5rem; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; }
  .list li { display: grid; gap: 0.4rem; padding-block: 1.25rem; border-top: 1px solid var(--rule); }
  .list p { color: var(--ink-2); }
</style>
