---
import Cta from "./Cta.astro";
import Program from "./Program.astro";
import { site } from "../site.config";
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">Tap a scene on your iPad. OBS puts your camera in it.</h1>
    <div class="act">
    <p class="lede">ViewSwitcher is a scene switcher for OBS on the Mac. Each scene is an HTML file your coding agent writes. Tap its cover on the iPad and it goes on air, with your camera, screen and iPad moved into the boxes the scene marks.</p>
    <Cta />
    <p class="quiet">{site.macAppReleased ? "Free and open source. For macOS, with OBS." : "Free and open source. Runs from source on a Mac today; the Mac app is next."}</p>
    </div>
  </div>
  <Program />
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 3.5rem); padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 6rem); }
  .copy { display: grid; gap: 1.75rem; }
  .act { display: grid; gap: 1.5rem; align-content: end; }
  h1 { max-width: 14ch; }
  @media (min-width: 64rem) { .copy { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4rem; align-items: end; } }
</style>
