---
import Cta from "./Cta.astro";
import Program from "./Program.astro";
import { cta } from "../site.config";
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">Look professional when you go live.</h1>
    <div class="act">
      <p class="lede">ViewSwitcher is a one-click scene switcher for OBS. Pick a view (intro, teaching, interview, break) and your camera, screen and titles move into place.</p>
      <Cta secondary={{ label: "See how it works", href: "#how" }} />
      <p class="quiet">{cta.note}</p>
    </div>
  </div>
  <Program />
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 3.5rem); padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 6rem); }
  .copy { display: grid; gap: 1.75rem; }
  .act { display: grid; gap: 1.5rem; align-content: end; }
  h1 { max-width: 12ch; }
  @media (min-width: 64rem) { .copy { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4rem; align-items: end; } }
</style>
