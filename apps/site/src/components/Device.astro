---
// A labelled stand-in for a device box (Camera, Screen, iPad) in a rendered scene.
import { box, type Slot } from "../lib/scenes";
interface Props { place: Slot }
const { place: slot } = Astro.props;
---
<div class:list={["device", `device-${slot.name}`, { round: slot.round }]} style={box(slot)} aria-hidden="true">
  <span>
    {slot.name === "Camera"
      ? <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="11.5" height="10" rx="2"/><path d="m13.5 9 4.5-2.5v7L13.5 11"/></svg>
      : <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="3.5" width="16" height="11" rx="1.6"/><path d="M7 17.5h6"/></svg>}
    {slot.name}
  </span>
</div>
