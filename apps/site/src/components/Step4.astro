---
// How it works, step 4 (Jono's design, Step4.dc.html): OBS on the Mac and an iPad running ViewSwitcher beside it.
// Laid out on the design's 1440 × 900 canvas; every size is in --u (1/1440 of the width), so it scales to fit.
// Like the hero: while it's on screen, a finger glides to the next view and taps it, the tile gets the red
// outline and ON AIR, and OBS's program fades to it in 300 ms. Tapping a tile takes over. Still with reduced
// motion; paused off screen.
import ViewFrame from "./ViewFrame.astro";
const views = [
  { file: "starting-soon", name: "Pregame", alt: "the pregame countdown" },
  { file: "live", name: "Host cam", alt: "the host with his name and the episode title" },
  { file: "main", name: "Both hosts", alt: "both hosts" },
  { file: "brb", name: "Break", alt: "the break screen" },
];
const start = 2;
---
<div class="s4" data-step4 data-start={start}>
  <div class="canvas">
    <div class="obs">
      <div class="title" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="t">OBS 31.0.0 · Profile: Full Count · Scenes: Untitled</span></div>
      <div class="program-area">
        <div class="program" role="img" aria-label={`OBS program: ${views[start]!.alt}`} data-program>
          {views.map((v, k) => (
            <div class:list={["shot", { on: k === start }]} data-shot={k} aria-hidden="true">
              <ViewFrame show="fullcount" file={v.file} alt="" sizes="(min-width: 60rem) 34rem, 75vw" widths={[480, 720, 960]} />
            </div>
          ))}
        </div>
      </div>
      <div class="docks" aria-hidden="true">
        <div class="dock"><span class="h">Scenes</span><span class="sel">ViewSwitcher</span><span>Webcam only</span></div>
        <div class="dock wide"><span class="h">Sources</span><span><em>◫</em>ViewSwitcher Program</span><span><em>◉</em>Camera</span><span><em>◉</em>Guest</span><span><em>▭</em>Screen</span></div>
        <div class="dock mixer"><span class="h">Audio Mixer</span>
          <div class="meters">
            <div><span class="row"><span>Mic/Aux</span><span class="q">-6.2 dB</span></span><span class="meter" style="--l:52%;--y:62%"></span></div>
            <div><span class="row"><span>Guest</span><span class="q">-9.0 dB</span></span><span class="meter" style="--l:41%;--y:41%"></span></div>
          </div>
        </div>
        <div class="dock"><span class="h">Scene Transitions</span><span class="box">Fade</span><span class="q pad">Duration 300 ms</span></div>
        <div class="dock controls"><span class="h">Controls</span><span class="b red">Stop Streaming</span><span class="b">Start Recording</span><span class="b">Studio Mode</span><span class="b">Settings</span></div>
      </div>
      <div class="status" aria-hidden="true"><span class="live"><i></i>LIVE 00:42:10</span><span>REC 00:00:00</span><span>CPU 3.1%</span><span>60.00 / 60.00 FPS</span></div>
    </div>

    <div class="ipad">
      <div class="bezel">
        <span class="cam" aria-hidden="true"></span>
        <div class="screen">
          <div class="side" aria-hidden="true">
            <b>ViewSwitcher</b>
            <span class="org">Full Count</span>
            <span class="lbl">PROJECTS</span>
            <span class="cur">Ep. 112</span>
            <span class="q">Ep. 111</span>
          </div>
          <div class="main">
            <div class="head"><b>Ep. 112</b><span class="pill" aria-live="polite"><i></i>On air: <span data-now>{views[start]!.name}</span></span></div>
            <div class="tiles" data-tiles>
              <span class="finger" data-finger aria-hidden="true"></span>
              {views.map((v, k) => (
                <button type="button" class="tile" data-tile={k} data-alt={v.alt} aria-pressed={k === start ? "true" : "false"}>
                  <span class="thumb" aria-hidden="true"><ViewFrame show="fullcount" file={v.file} alt="" sizes="(min-width: 60rem) 7rem, 20vw" widths={[240, 360]} /><span class="tag">ON AIR</span></span>
                  <span class="name">{v.name}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .s4 { container-type: inline-size; border-radius: 18px; overflow: hidden; }
  .canvas { --u: calc(100cqw / 1440); position: relative; aspect-ratio: 1440 / 900; background: #eef0f3; font-family: "Instrument Sans", system-ui, sans-serif; }

  /* OBS Studio 31, the dark theme. */
  .obs { position: absolute; left: calc(56 * var(--u)); top: calc(56 * var(--u)); width: calc(1000 * var(--u)); height: calc(680 * var(--u)); box-sizing: border-box; border-radius: calc(12 * var(--u)); background: #1e1f24; border: 1px solid #3b3d45; box-shadow: 0 calc(40 * var(--u)) calc(80 * var(--u)) calc(-30 * var(--u)) #0000008c; overflow: hidden; display: flex; flex-direction: column; color: #dfe1e6; font-size: calc(12 * var(--u)); }
  .title { height: calc(30 * var(--u)); flex: none; background: #2b2c33; display: flex; align-items: center; padding: 0 calc(12 * var(--u)); position: relative; }
  .dots { display: flex; gap: calc(8 * var(--u)); }
  .dots i { width: calc(12 * var(--u)); height: calc(12 * var(--u)); border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .title .t { position: absolute; inset: 0; display: grid; place-items: center; color: #b5b8c0; }
  /* The program: 16:9, letterboxed in its area, never overflowing it. */
  .program-area { position: relative; flex: 1; min-height: 0; margin: calc(8 * var(--u)) calc(8 * var(--u)) 0; background: #000; overflow: hidden; }
  /* The area is 982 × 428 (in --u), wider than 16:9, so a full-height 16:9 program always fits. */
  .program { position: absolute; top: 0; bottom: 0; left: 50%; translate: -50% 0; aspect-ratio: 16 / 9; }
  .shot { position: absolute; inset: 0; opacity: 0; transition: opacity 300ms ease; }
  .shot.on { opacity: 1; }
  .docks { height: calc(190 * var(--u)); flex: none; display: flex; gap: calc(6 * var(--u)); padding: calc(8 * var(--u)); box-sizing: border-box; }
  .dock { flex: 1; min-width: 0; background: #26272d; border: 1px solid #34363e; display: flex; flex-direction: column; overflow: hidden; white-space: nowrap; }
  .dock.wide { flex: 1.3; }
  .dock.mixer { flex: 1.6; }
  .dock > span { margin: 0 calc(4 * var(--u)); padding: calc(5 * var(--u)) calc(8 * var(--u)); }
  .dock > .h { margin: 0 0 calc(4 * var(--u)); background: #2d2f36; font-size: calc(11 * var(--u)); color: #b5b8c0; }
  .dock .sel { background: #3a59d1; color: #fff; }
  .dock em { font-style: normal; color: #8a8d96; margin-right: calc(8 * var(--u)); }
  .meters { padding: calc(4 * var(--u)) calc(10 * var(--u)); display: grid; gap: calc(12 * var(--u)); }
  .meters > div { display: grid; gap: calc(5 * var(--u)); }
  .row { display: flex; justify-content: space-between; }
  .q { color: #9a9da6; }
  .meter { height: calc(6 * var(--u)); border-radius: 2px; background: linear-gradient(90deg, #3fbf5a 0 var(--l), #d9c13a var(--l) var(--y), #3a3c44 var(--y)); }
  .dock .box { margin: calc(2 * var(--u)) calc(8 * var(--u)) calc(6 * var(--u)); border: 1px solid #3b3d45; border-radius: 3px; }
  .dock .pad { margin-top: 0; padding-top: 0; }
  .controls { gap: calc(4 * var(--u)); }
  .controls .b { margin: 0 calc(6 * var(--u)); padding: calc(6 * var(--u)); text-align: center; border-radius: 3px; background: #33353d; }
  .controls .red { background: #b3261e; color: #fff; font-weight: 600; }
  .status { height: calc(22 * var(--u)); flex: none; background: #2b2c33; display: flex; align-items: center; justify-content: flex-end; gap: calc(16 * var(--u)); padding: 0 calc(12 * var(--u)); font-size: calc(11 * var(--u)); color: #b5b8c0; }
  .status .live { display: flex; align-items: center; gap: calc(6 * var(--u)); color: #ffb4ab; }
  .status .live i { width: calc(7 * var(--u)); height: calc(7 * var(--u)); border-radius: 50%; background: #ef4444; }

  /* An iPad in landscape, running ViewSwitcher's stream page. */
  .ipad { position: absolute; right: calc(56 * var(--u)); bottom: calc(48 * var(--u)); width: calc(620 * var(--u)); height: calc(445 * var(--u)); border-radius: calc(34 * var(--u)); background: #2a2b2f; padding: calc(3 * var(--u)); box-sizing: border-box; box-shadow: 0 calc(40 * var(--u)) calc(80 * var(--u)) calc(-24 * var(--u)) #00000099, inset 0 0 0 1px #6b6d74; }
  .bezel { width: 100%; height: 100%; border-radius: calc(31 * var(--u)); background: #050506; padding: calc(15 * var(--u)); box-sizing: border-box; position: relative; }
  .cam { position: absolute; left: 50%; top: calc(5 * var(--u)); width: calc(6 * var(--u)); height: calc(6 * var(--u)); margin-left: calc(-3 * var(--u)); border-radius: 50%; background: #1d1f26; }
  .screen { width: 100%; height: 100%; border-radius: calc(17 * var(--u)); overflow: hidden; background: #111216; display: flex; color: #f3f4f6; }
  .side { width: calc(132 * var(--u)); flex: none; background: #15161a; border-right: 1px solid #24262c; padding: calc(14 * var(--u)) calc(10 * var(--u)); box-sizing: border-box; display: flex; flex-direction: column; gap: calc(10 * var(--u)); font-size: calc(11 * var(--u)); white-space: nowrap; }
  .side b { font: 700 calc(13 * var(--u)) var(--display); }
  .side .org { padding: calc(6 * var(--u)) calc(8 * var(--u)); border-radius: calc(6 * var(--u)); border: 1px solid #2a2d35; }
  .side .lbl { color: #8a8d96; letter-spacing: 0.12em; font-size: calc(9 * var(--u)); }
  .side .cur { padding: calc(5 * var(--u)) calc(8 * var(--u)); border-radius: calc(6 * var(--u)); background: #23262e; }
  .side .q { padding: 0 calc(8 * var(--u)); }
  .main { flex: 1; min-width: 0; padding: calc(14 * var(--u)) calc(16 * var(--u)); display: flex; flex-direction: column; gap: calc(12 * var(--u)); }
  .head { display: flex; align-items: center; gap: calc(8 * var(--u)); }
  .head b { font: 700 calc(17 * var(--u)) var(--display); }
  .pill { margin-left: auto; display: flex; align-items: center; gap: calc(6 * var(--u)); padding: calc(5 * var(--u)) calc(10 * var(--u)); border-radius: 999px; background: #23262e; font-size: calc(11 * var(--u)); white-space: nowrap; }
  .pill i { width: calc(7 * var(--u)); height: calc(7 * var(--u)); border-radius: 50%; background: #ef4444; }
  .tiles { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(12 * var(--u)); }
  .tile { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: calc(6 * var(--u)); position: relative; border-radius: calc(8 * var(--u)); }
  .tile:focus-visible { outline: 2px solid #fff; outline-offset: calc(4 * var(--u)); }
  .thumb { position: relative; display: block; border-radius: calc(8 * var(--u)); outline: calc(3 * var(--u)) solid transparent; outline-offset: calc(2 * var(--u)); transition: outline-color 200ms; }
  .thumb :global(.frame) { border-radius: calc(8 * var(--u)); }
  .tile[aria-pressed="true"] .thumb { outline-color: #ef4444; }
  .tag { position: absolute; left: calc(8 * var(--u)); top: calc(8 * var(--u)); padding: calc(3 * var(--u)) calc(7 * var(--u)); border-radius: calc(4 * var(--u)); background: #dc2626; color: #fff; font-size: calc(9 * var(--u)); font-weight: 700; letter-spacing: 0.1em; opacity: 0; transition: opacity 200ms; }
  .tile[aria-pressed="true"] .tag { opacity: 1; }
  .name { font-size: calc(12 * var(--u)); font-weight: 600; }
  .finger { position: absolute; z-index: 2; pointer-events: none; left: 0; top: 0; width: calc(34 * var(--u)); height: calc(34 * var(--u)); margin: calc(-17 * var(--u)) 0 0 calc(-17 * var(--u)); border-radius: 50%; background: #ffffffcc; box-shadow: 0 0 0 calc(8 * var(--u)) #ffffff40; opacity: 0; transition: transform 600ms cubic-bezier(.4, 0, .2, 1), opacity 300ms, box-shadow 150ms, scale 150ms; }
  .finger.show { opacity: 1; }
  .finger.tap { scale: 0.8; box-shadow: 0 0 0 calc(16 * var(--u)) #ffffff1f; }
  @media (prefers-reduced-motion: reduce) { .shot, .thumb, .tag, .finger { transition: none; } .finger { display: none; } }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-step4]")) {
    const shots = [...root.querySelectorAll<HTMLElement>("[data-shot]")];
    const tiles = [...root.querySelectorAll<HTMLButtonElement>("[data-tile]")];
    const grid = root.querySelector<HTMLElement>("[data-tiles]")!;
    const finger = root.querySelector<HTMLElement>("[data-finger]")!;
    const program = root.querySelector<HTMLElement>("[data-program]")!;
    const now = root.querySelector<HTMLElement>("[data-now]")!;
    let current = Number(root.dataset.start ?? 0);

    const show = (i: number) => {
      current = i;
      shots.forEach((s, k) => s.classList.toggle("on", k === i));
      tiles.forEach((t, k) => t.setAttribute("aria-pressed", String(k === i)));
      now.textContent = tiles[i]!.querySelector(".name")!.textContent;
      program.setAttribute("aria-label", `OBS program: ${tiles[i]!.dataset.alt}`);
    };
    const aim = (i: number) => {
      const g = grid.getBoundingClientRect(), t = tiles[i]!.querySelector(".thumb")!.getBoundingClientRect();
      finger.style.transform = `translate(${t.left - g.left + t.width * 0.6}px, ${t.top - g.top + t.height * 0.55}px)`;
    };

    // Until someone taps, a finger walks the views in order.
    let timer = 0, visible = false, stopped = false;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const later = (f: () => void, ms: number) => { timer = window.setTimeout(f, ms); };
    const tick = () => {
      if (stopped || !visible || reduced.matches || document.hidden) return;
      const next = (current + 1) % tiles.length;
      aim(next);
      finger.classList.add("show");
      later(() => {
        finger.classList.add("tap");
        later(() => { finger.classList.remove("tap"); show(next); later(tick, 2000); }, 150);
      }, 650);
    };
    const stop = () => { stopped = true; clearTimeout(timer); finger.classList.remove("show", "tap"); };
    aim(current);
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      clearTimeout(timer);
      if (!visible) finger.classList.remove("tap");
      if (visible && !stopped) later(tick, 1200);
    }, { threshold: 0.4 }).observe(root);
    document.addEventListener("visibilitychange", () => { clearTimeout(timer); if (!document.hidden && visible && !stopped) later(tick, 1200); });
    tiles.forEach((t, k) => t.addEventListener("click", (e) => { if (e.isTrusted) stop(); show(k); }));
  }
</script>
