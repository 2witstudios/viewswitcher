---
// The two-screens mark (apps/web/public/icon.svg) light on the dark page.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="7.5" y="4" width="13.5" height="10" rx="2.6" stroke="#a3a8b5" stroke-width="1.8" fill="none" />
  <rect x="3" y="10" width="13.5" height="10" rx="2.6" fill="#f4f5f7" stroke="#0f1115" stroke-width="1.6" paint-order="stroke" />
</svg>
