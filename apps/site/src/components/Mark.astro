---
// The V of screens on its own (src/lib/brand.ts), the one on air in red. As the app icon (`tile`):
// white screens on the monitor black. Bare: screens in the text colour, as in the hero's title bar.
import { iconBody } from "../lib/brand";
interface Props { size?: number; tile?: boolean }
const { size = 28, tile = true } = Astro.props;
const body = tile
  ? `<rect width="24" height="24" rx="5.4" fill="#0b0c0f"/><g transform="translate(2.4 2.4) scale(.8)">${iconBody("#f4f5f7")}</g>`
  : iconBody();
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={body} />
