---
// How it works (SITE-27, from Jono's design): 1 create a custom template, 2 add it to your stream,
// 3 click to switch. AI_CONNECT_RELEASED (site.config.ts) adds the AI sentence and the chat picture to step 1.
import { Picture } from "astro:assets";
import ViewFrame from "./ViewFrame.astro";
import { github, site } from "../site.config";
import stream from "../assets/app/stream-fullcount.webp";
const ai = site.aiConnect;
const skill = `${github}/blob/main/apps/server/library-kit/skills/viewswitcher-scenes/SKILL.md`;
const covers: [string, string][] = [["fullcount", "main"], ["nova", "main"], ["grace", "main"], ["kitchen", "starting-soon"]];
---
<section class="section" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="how-title">How it works</h2>
      <p class="lede">Set up your views once. Then every show is a click away, and OBS keeps streaming the way it always does.</p>
    </div>
    <ol class="steps">
      <li>
        {ai ? (
          <div class="vis ask">
            <p class="bubble">Make a halftime screen for Full Count with a 4-minute countdown.</p>
            <div class="made"><ViewFrame show="fullcount" file="brb" alt="The halftime screen: highlights beside a countdown and what's up next, under the Full Count title bar" sizes="(min-width: 60rem) 20rem, calc(100vw - 2.5rem)" widths={[320, 480, 640, 960]} /></div>
          </div>
        ) : (
          <div class="vis covers" aria-hidden="true">
            {covers.map(([show, file]) => <ViewFrame show={show} file={file} alt="" sizes="(min-width: 60rem) 11rem, 45vw" widths={[240, 360, 480]} />)}
          </div>
        )}
        <h3><span class="n">1</span>Create a custom template</h3>
        {ai
          ? <p>Start from a built-in or <a href="/templates">downloaded template</a>, or connect your favorite AI (Claude, Cursor, any app with MCP) in one click and describe what you want: an overlay, slides, a countdown. Templates are small web pages, so you can also code your own with the <a href={skill}>ViewSwitcher skill</a>.</p>
          : <p>Start from a built-in or <a href="/templates">downloaded template</a>. Templates are small web pages, so you can also code your own with the <a href={skill}>ViewSwitcher skill</a>.</p>}
      </li>
      <li>
        <div class="vis shot">
          <Picture src={stream} alt="ViewSwitcher on the Mac: Full Count's Ep. 112 stream with its Pregame, Host cam, Both hosts, Break and Final whistle views, Both hosts on air." widths={[480, 720, 960, 1280]} sizes="(min-width: 60rem) 22rem, calc(100vw - 2.5rem)" formats={["webp"]} loading="lazy" decoding="async" />
        </div>
        <h3><span class="n">2</span>Add it to your stream</h3>
        <p>Make a stream for this week's show and add the views you need. Retype the titles for this episode right on the view; the template stays the same for next week.</p>
      </li>
      <li>
        <div class="vis onair" style="background:#0b1426"><ViewFrame show="fullcount" file="main" alt="Full Count on air: both hosts with their names and the episode title" sizes="(min-width: 60rem) 22rem, calc(100vw - 2.5rem)" widths={[480, 720, 960, 1280]} /></div>
        <h3><span class="n">3</span>Click to switch and control your live</h3>
        <p>Click a view on your Mac, or tap it on an iPad or a paired phone. Your camera, screen share and titles move into place, and OBS keeps streaming as usual. <a href="/setup">How to set up OBS</a></p>
      </li>
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem 2rem; }
  @media (min-width: 60rem) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .steps li { display: grid; gap: 0.85rem; align-content: start; }
  .steps p { color: var(--ink-2); max-width: 30rem; }
  h3 { display: flex; align-items: baseline; gap: 0.6rem; margin-top: 0.75rem; }
  .n { font: 700 0.9375rem/1 var(--display); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .vis { aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; }

  /* Step 1, AI on: the request above the screen it made. */
  .ask { background: var(--raised); border: 1px solid var(--rule); padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .steps .bubble { margin: 0; align-self: flex-end; max-width: 88%; padding: 0.6rem 0.85rem; border-radius: 14px 14px 4px 14px; background: var(--ink); color: var(--paper); font-size: 0.8125rem; line-height: 1.4; }
  .made { flex: 1; min-height: 0; display: flex; justify-content: center; }
  .made :global(.frame) { height: 100%; max-width: 100%; border-radius: 8px; }
  /* Step 1, AI off: template covers. */
  .covers { background: var(--raised); border: 1px solid var(--rule); padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; align-content: center; }
  .covers :global(.frame) { border-radius: 6px; }
  /* Step 2: the real stream page. */
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 0 0; display: block; }
  .shot :global(picture) { display: block; height: 100%; }
  /* Step 3: the whole 16:9 view in the 16:10 frame, on the show's own ground. */
  .onair { display: grid; align-content: center; }
</style>
