{
  "name": "@viewswitcher/mac",
  "productName": "ViewSwitcher",
  "version": "0.1.0",
  "description": "ViewSwitcher for macOS: the switcher, its server and a menu-bar status in one app.",
  "author": "2wit Studios",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "bun build src/main.ts --target=node --format=cjs --external electron --outfile dist/main.cjs",
    "start": "bun run bundle && (test -d node_modules/electron/dist || node node_modules/electron/install.js) && electron .",
    "build": "bash scripts/build.sh",
    "release": "bash scripts/build.sh --release",
    "e2e": "bun scripts/e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@viewswitcher/shared": "workspace:*",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
