# App Store Connect API key for bun run mac:release and bun run ipad:release (MAC-17).
# Copy to apps/apple/.release.env (gitignored) and fill in. The environment overrides this file.
# Never put the key itself here: only its ID, the issuer ID and the path to the .p8 file.

# Users and Access → Integrations → App Store Connect API, the "Key ID" column.
ASC_KEY_ID=BS7KAPCGBR
# The "Issuer ID" above the list of keys on that page (a UUID).
ASC_ISSUER_ID=
# Optional: defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_BS7KAPCGBR.p8
