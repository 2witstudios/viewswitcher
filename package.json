{
  "name": "viewswitcher",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@viewswitcher/*' dev",
    "build": "bun run --filter @viewswitcher/web build",
    "start": "bun run build && bun apps/server/src/index.ts",
    "test": "bun test",
    "obs:setup": "bun apps/server/src/obs-setup.ts",
    "ipad:sync": "bun run --filter @viewswitcher/ipad sync",
    "ipad:deploy": "bash apps/ipad/scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
