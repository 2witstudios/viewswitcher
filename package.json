{
  "name": "viewswitcher",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@viewswitcher/*' dev",
    "build": "bun run --filter @viewswitcher/web build",
    "start": "bun run build && bun apps/server/src/index.ts",
    "test": "bun test",
    "typecheck": "cd apps/web && tsc --noEmit && tsc -p tsconfig.test.json && cd ../server && tsc -p . && cd ../../packages/shared && tsc -p . && tsc -p tsconfig.test.json && cd ../packs && tsc -p .",
    "obs:setup": "bun apps/server/src/obs-setup.ts",
    "ipad:deploy": "bash apps/apple/scripts/deploy-ipad.sh",
    "ipad:release": "bash apps/apple/scripts/ipad-release.sh",
    "mac:dev": "bash apps/apple/scripts/dev.sh",
    "mac:build": "bash apps/apple/scripts/build.sh",
    "mac:release": "bash apps/apple/scripts/build.sh --release",
    "mac:e2e": "bun apps/apple/scripts/e2e.ts",
    "win:dev": "bun apps/windows/scripts/dev.ts",
    "win:build": "bun apps/windows/scripts/build.ts",
    "win:release": "bun apps/windows/scripts/build.ts --release",
    "win:e2e": "bun apps/windows/scripts/e2e.ts",
    "win:test": "dotnet test apps/windows/ViewSwitcher.Core.Tests",
    "win:icons": "bun apps/windows/scripts/icons.ts",
    "brand:icons": "bun scripts/brand/icons.ts",
    "packs:export": "bun apps/server/src/export-packs.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
