{
  "name": "viewswitcher",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@viewswitcher/*' dev",
    "build": "bun run --filter @viewswitcher/web build",
    "start": "bun run build && bun apps/server/src/index.ts",
    "test": "bun test",
    "obs:setup": "bun apps/server/src/obs-setup.ts",
    "ipad:deploy": "bash apps/apple/scripts/deploy-ipad.sh",
    "ipad:release": "bash apps/apple/scripts/ipad-release.sh",
    "mac:dev": "bash apps/apple/scripts/dev.sh",
    "mac:build": "bash apps/apple/scripts/build.sh",
    "mac:release": "bash apps/apple/scripts/build.sh --release",
    "mac:e2e": "bun apps/apple/scripts/e2e.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
